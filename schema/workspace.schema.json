{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskly.example/schema/workspace.schema.json",
  "title": "Workspace",
  "description": "Metadata for an explicitly initialized workspace. schema_version is the persisted Python storage version, not the contract release number.",
  "type": "object",
  "properties": {
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/stable_id"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/required_short_text"
    },
    "timezone": {
      "$ref": "common.schema.json#/$defs/timezone"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "workspace_id",
    "name",
    "timezone",
    "schema_version"
  ],
  "additionalProperties": false
}
