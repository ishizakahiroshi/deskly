{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskly.example/schema/contact_record.schema.json",
  "title": "ContactRecord",
  "type": "object",
  "properties": {
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/stable_id"
    },
    "source_id": {
      "$ref": "common.schema.json#/$defs/stable_id"
    },
    "version": {
