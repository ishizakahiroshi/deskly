{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskly.example/schema/project.schema.json",
  "title": "Project",
  "description": "Normalized Python workspace entity. All persisted data fields are required; optional projections are read-only and must not be sent as mutable data.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/entity_metadata/properties/id"
    },
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/entity_metadata/properties/workspace_id"
    },
    "project_id": {
      "type": "null"
    },
    "type": {
      "const": "project"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/entity_metadata/properties/version"
    },
    "archived": {
      "$ref": "common.schema.json#/$defs/entity_metadata/properties/archived"
    },
    "name": {
      "$ref": "#/$defs/data/properties/name"
    },
    "purpose": {
      "$ref": "#/$defs/data/properties/purpose"
    },
    "owner_id": {
      "$ref": "#/$defs/data/properties/owner_id"
    },
    "state": {
      "$ref": "#/$defs/data/properties/state"
    },
    "next_milestone": {
      "$ref": "common.schema.json#/$defs/text",
      "readOnly": true
    },
    "next_action": {
      "$ref": "common.schema.json#/$defs/text",
      "readOnly": true
    },
    "check_date": {
      "$ref": "common.schema.json#/$defs/optional_date",
      "readOnly": true
    },
    "waiting_reason": {
      "$ref": "common.schema.json#/$defs/text",
      "readOnly": true
    },
    "unconfirmed_count": {
      "type": "integer",
      "minimum": 0,
      "readOnly": true
    }
  },
  "required": [
    "id",
    "workspace_id",
    "project_id",
    "type",
    "version",
    "archived",
    "name",
    "purpose",
    "owner_id",
    "state"
  ],
  "additionalProperties": false,
  "$defs": {
    "data": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/required_short_text"
        },
        "purpose": {
          "$ref": "common.schema.json#/$defs/required_long_text"
        },
        "owner_id": {
          "$ref": "common.schema.json#/$defs/stable_id",
          "description": "Business owner member ID, not a workspace authorization role."
        },
        "state": {
          "$ref": "common.schema.json#/$defs/project_state"
        }
      },
      "required": [
        "name",
        "purpose",
        "owner_id",
        "state"
      ],
      "additionalProperties": false,
      "description": "Exact mutable FIELDS[\"project\"] from workspace_service.py. Creation/update submit the complete object; empty optional fields remain present."
    }
  }
}
