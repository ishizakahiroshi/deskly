# Copy to /opt/deskly/app/web.env.local, set mode 600, and replace both placeholders.
# This file contains no password or token. Credentials are stored under /data.
DESKLY_HOME=/data
DESKLY_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
DESKLY_CREDENTIAL_STORE=/data/shared-credentials.sqlite3
DESKLY_PUBLIC_ORIGIN=https://deskly.example.invalid
DESKLY_WEB_PORT=8766
