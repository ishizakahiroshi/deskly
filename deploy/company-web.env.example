# Copy to /opt/deskly/app/web.env.local, set mode 600, and replace the placeholders.
# Set DESKLY_CONTACT_READ_TOKEN once in the adjacent private project .env;
# Compose passes it to the private app/web containers, not the ingress network.
DESKLY_HOME=/data
DESKLY_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
DESKLY_CREDENTIAL_STORE=/data/shared-credentials.sqlite3
DESKLY_PUBLIC_ORIGIN=https://deskly.example.invalid
DESKLY_WEB_PORT=8766
# Reverse proxy addresses or CIDRs (comma separated) whose X-Real-IP /
# X-Forwarded-For are used to count login failures per real client. Empty
# (the default) ignores those headers; then every user behind the proxy shares
# one failure counter per login name. Set it to the deskly_ingress subnet.
DESKLY_TRUSTED_PROXIES=
