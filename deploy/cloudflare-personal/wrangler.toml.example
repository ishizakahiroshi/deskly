name = "deskly-personal"
main = "./src/worker.js"
compatibility_date = "2026-09-28"
workers_dev = false
preview_urls = false

[assets]
directory = "./public"
binding = "ASSETS"
run_worker_first = true
# The Worker maps / to /index.html; do not redirect that asset back to /.
html_handling = "none"

[[d1_databases]]
binding = "DB"
database_name = "deskly-personal"
database_id = "00000000-0000-0000-0000-000000000000"
migrations_dir = "migrations"

[vars]
PUBLIC_ORIGIN = "https://deskly.example.invalid"
ACCESS_TEAM_DOMAIN = "https://example.cloudflareaccess.com"
ACCESS_AUD = "replace-with-access-application-audience"
OWNER_EMAIL = "owner@example.com"
